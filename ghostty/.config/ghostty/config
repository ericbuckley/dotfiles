# vim: set ft=dosini :

# theme
theme = light:Spacedust,dark:TokyoNight Night

# font settings
font-family = JetBrains Mono
font-size = 16
bold-color = bright

# cursor settings
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# macOS-specific
macos-option-as-alt = left
macos-titlebar-style = hidden
window-padding-x = 5
window-padding-y = 5
window-padding-balance = true

auto-update = check
